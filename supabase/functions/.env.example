# Server-only values for local Supabase function testing.
CLOUDFLARE_ACCOUNT_ID=YOUR_32_CHARACTER_ACCOUNT_ID
CLOUDFLARE_AI_TOKEN=YOUR_WORKERS_AI_API_TOKEN
# Set workers-free only after confirming the Cloudflare account is on Workers Free.
MOTION_AI_CLOUDFLARE_PLAN=disabled
# YouTube lessons use Google Gemini (aistudio.google.com → Get API key). Server-only; never put it in the browser .env.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
MOTION_AI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
