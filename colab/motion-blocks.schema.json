{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Motion AI page proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "blocks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "content"
            ],
            "properties": {
              "type": {
                "enum": [
                  "text",
                  "heading1",
                  "heading2",
                  "heading3",
                  "bulleted",
                  "numbered",
                  "todo",
                  "quote",
                  "callout",
                  "code",
                  "toggle"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "rows"
            ],
            "properties": {
              "type": {
                "const": "table"
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "maxLength": 2000
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "divider"
              }
            }
          }
        ]
      }
    }
  }
}
